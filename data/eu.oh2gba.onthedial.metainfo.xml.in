<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>eu.oh2gba.onthedial</id>
  <launchable type="desktop-id">@OTD_DESKTOP_ID@.desktop</launchable>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>On The Dial</name>
  <developer id="eu.oh2gba"><name>John, OH2GBA</name></developer>
  <summary>Who is on the shortwave frequency you are tuned to</summary>
  <description>
    <p>On The Dial follows the VFO of your receiver through Hamlib's rigctld and shows which
       shortwave stations are scheduled on or near that frequency right now: broadcasters,
       utility stations, time signals and oddities such as The Buzzer.</p>
    <ul>
      <li>Live on-air status from the EiBi, HFCC and Aoki schedules, evaluated against UTC</li>
      <li>Follows the rig, or type a frequency; double-click a station to tune there</li>
      <li>Search the whole database by station, language, site or country</li>
      <li>Mode column: AM, USB, LSB, CW, DRM, RTTY, FAX, HFDL</li>
      <li>Your own list of identifications, with import and export</li>
      <li>Can start rigctld for you; works with gqrx and SDR++ rigctl servers too</li>
    </ul>
  </description>
  <screenshots>
    <screenshot type="default">
      <caption>Stations on air near the tuned frequency</caption>
      <image>https://onthedial.oh2gba.eu/screenshot.png</image>
    </screenshot>
  </screenshots>
  <url type="homepage">https://onthedial.oh2gba.eu/</url>
  <url type="help">https://onthedial.oh2gba.eu/rig.html</url>
  <url type="bugtracker">https://github.com/oh2gba/onthedial/issues</url>
  <url type="vcs-browser">https://github.com/oh2gba/onthedial</url>
  <content_rating type="oars-1.1"/>
  <categories><category>HamRadio</category><category>Network</category></categories>
  <keywords><keyword>shortwave</keyword><keyword>SWL</keyword><keyword>rigctld</keyword><keyword>EiBi</keyword></keywords>
  <releases>
    <release version="1.4.0" date="2026-09-22">
      <description>
        <ul>
          <li>Search: every word must match ("bbc english"), a leading "!" excludes a word ("!china english"); country names are matched too</li>
          <li>Downloads show their progress and resume after a slow server drops the connection, so the Aoki list loads reliably</li>
          <li>Band indicator also names well known unlicensed uses: pirate and free radio bands, the 11 m freeband, ISM bands</li>
          <li>"On air only" no longer leaves the dial view blank</li>
        </ul>
      </description>
    </release>
    <release version="1.3.1" date="2026-09-22">
      <description><p>The version check runs once after start and every 24 hours while the program is running; the link to a newer version now sits above the clock.</p></description>
    </release>
    <release version="1.3.0" date="2026-09-22">
      <description>
        <ul>
          <li>Dial view refined: one continuous table, blank rows at the ends of the list so the tuned frequency always stays in the middle, no row selection, a short blink on the row sent to the radio</li>
          <li>Right-click on the column header to choose the columns, double-click to fit them to the data and the window</li>
          <li>Search returns every match; Escape clears the search; double-clicking a result keeps the search open</li>
        </ul>
      </description>
    </release>
    <release version="1.2.0" date="2026-09-22">
      <description>
        <ul>
          <li>Dial view: the tuned frequency stays in the middle of the list, lower frequencies above it and higher ones below, like a tuning scale</li>
          <li>Entries within the chosen ± kHz range are shown in red</li>
          <li>Column widths follow the window width</li>
        </ul>
      </description>
    </release>
    <release version="1.1.1" date="2026-09-22">
      <description><p>The version check now succeeds on hosts where IPv6 connections hang.</p></description>
    </release>
    <release version="1.1.0" date="2026-09-22">
      <description>
        <ul>
          <li>Optional daily check for a new version, shown as a small note in the status bar</li>
          <li>Any additional station list found in the database is shown alongside the downloaded ones</li>
          <li>Fixed a crash on exit</li>
        </ul>
      </description>
    </release>
    <release version="1.0.2" date="2026-09-20">
      <description><p>Builds cleanly against Qt 6.10 and newer.</p></description>
    </release>
    <release version="1.0.1" date="2026-09-20">
      <description>
        <ul>
          <li>Band plan indicator next to the frequency (broadcast, amateur, aeronautical, maritime, time signal bands) with an ITU region setting</li>
          <li>macOS build and Flatpak packaging</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2026-09-20">
      <description><p>First release.</p></description>
    </release>
  </releases>
</component>
